{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "env -u NODE_OPTIONS -u npm_config_node_options /usr/local/bin/agentreel cursor-hook sessionStart",
        "timeout": 5
      }
    ],
    "sessionEnd": [
      {
        "command": "env -u NODE_OPTIONS -u npm_config_node_options /usr/local/bin/agentreel cursor-hook sessionEnd",
        "timeout": 5
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "env -u NODE_OPTIONS -u npm_config_node_options /usr/local/bin/agentreel cursor-hook beforeSubmitPrompt",
        "timeout": 5
      }
    ],
    "preToolUse": [
      {
        "command": "env -u NODE_OPTIONS -u npm_config_node_options /usr/local/bin/agentreel cursor-hook preToolUse",
        "timeout": 130,
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "env -u NODE_OPTIONS -u npm_config_node_options /usr/local/bin/agentreel cursor-hook beforeShellExecution",
        "timeout": 130,
        "failClosed": true
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "env -u NODE_OPTIONS -u npm_config_node_options /usr/local/bin/agentreel cursor-hook beforeMCPExecution",
        "timeout": 130,
        "failClosed": true
      }
    ],
    "beforeReadFile": [
      {
        "command": "env -u NODE_OPTIONS -u npm_config_node_options /usr/local/bin/agentreel cursor-hook beforeReadFile",
        "timeout": 130,
        "failClosed": true
      }
    ],
    "postToolUse": [
      {
        "command": "env -u NODE_OPTIONS -u npm_config_node_options /usr/local/bin/agentreel cursor-hook postToolUse",
        "timeout": 5
      }
    ],
    "postToolUseFailure": [
      {
        "command": "env -u NODE_OPTIONS -u npm_config_node_options /usr/local/bin/agentreel cursor-hook postToolUseFailure",
        "timeout": 5
      }
    ],
    "afterShellExecution": [
      {
        "command": "env -u NODE_OPTIONS -u npm_config_node_options /usr/local/bin/agentreel cursor-hook afterShellExecution",
        "timeout": 5
      }
    ],
    "afterMCPExecution": [
      {
        "command": "env -u NODE_OPTIONS -u npm_config_node_options /usr/local/bin/agentreel cursor-hook afterMCPExecution",
        "timeout": 5
      }
    ],
    "afterFileEdit": [
      {
        "command": "env -u NODE_OPTIONS -u npm_config_node_options /usr/local/bin/agentreel cursor-hook afterFileEdit",
        "timeout": 5
      }
    ],
    "subagentStop": [
      {
        "command": "env -u NODE_OPTIONS -u npm_config_node_options /usr/local/bin/agentreel cursor-hook subagentStop",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "env -u NODE_OPTIONS -u npm_config_node_options /usr/local/bin/agentreel cursor-hook stop",
        "timeout": 5
      }
    ]
  }
}
