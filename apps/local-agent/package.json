{
  "name": "@agentreel/agent",
  "version": "0.2.5",
  "description": "The local agent for AgentReel. It captures coding-agent sessions on your machine, scrubs PII before anything leaves it, and ships replays you can share and scrub.",
  "keywords": [
    "ai",
    "agent",
    "observability",
    "replay",
    "timeline",
    "developer-tools",
    "agentreel"
  ],
  "homepage": "https://github.com/agentreel/agent#readme",
  "bugs": {
    "url": "https://github.com/agentreel/agent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentreel/agent.git",
    "directory": "apps/local-agent"
  },
  "license": "Apache-2.0",
  "author": "AgentReel <hello@agentreel.dev>",
  "type": "module",
  "bin": {
    "agentreel": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "prepack": "cp ../../CHANGELOG.md CHANGELOG.md",
    "prepublishOnly": "pnpm build",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "chokidar": "^4.0.1",
    "commander": "^12.1.0",
    "diff": "^8.0.4",
    "diff-match-patch": "^1.0.5",
    "ignore": "^6.0.2",
    "nanoid": "^5.0.7",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@agentreel/shared-types": "workspace:*",
    "@types/better-sqlite3": "^7.6.11",
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^20.16.5",
    "tsup": "^8.3.0",
    "typescript": "^5.6.2",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
