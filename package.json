{
  "name": "agentreel-agent-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "AgentReel local agent — captures Claude Code and Cursor sessions on your machine.",
  "scripts": {
    "build": "pnpm -r build",
    "agent": "pnpm --filter @agentreel/agent",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "render-readme-logo": "node scripts/render-readme-logo.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.18.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp"
    ]
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "sharp": "^0.33.5"
  }
}
